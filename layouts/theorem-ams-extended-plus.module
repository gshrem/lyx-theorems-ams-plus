#\DeclareLyXModule{Theorems (AMS-Extended) Plus}
#\DeclareCategory{Maths}
#DescriptionBegin
#Additional theorem environments: Criterion, Algorithm, Axiom, Condition,
#Notes, Notation, Summary, Acknowledgement, Conclusion, Assumption, Question,
#Counterexample, Auxiliary Claim, Answer and unnumbered variants,
#plus Examples*.
#DescriptionEnd
#Requires: theorem-ams-plus

# Original Author : David L. Johnson <dlj0@lehigh.edu>
# Probably broken by Jean-Marc Lasgouttes <Jean-Marc.Lasgouttes@inria.fr>
# modified and modularized by Emmanuel GUREGHIAN <gureghia@boston.bertin.fr>
# Tinkered with Sep. '07 by Paul Rubin <rubin@msu.edu>
# Modularized Jan 08 by Richard Heck <rgheck@comcast.net>


Format 111

# Menu order within categories. Every entry is defined below or in the
# included extras file; optional layouts are never declared by the base module.
Style Notation
End

Style Notation*
End

Style Axiom
End

Style Axiom*
End

Style Assumption
End

Style Assumption*
End

Style Condition
End

Style Condition*
End

Style Criterion
End

Style Criterion*
End

Style AuxiliaryClaim
End

Style AuxiliaryClaim*
End

Style Examples*
End

Style CountersExample
End

Style CountersExample*
End

Style Question
End

Style Question*
End

Style Algorithm
End

Style Algorithm*
End

Style Answer
End

Style Answer*
End

Style Notes
End

Style Notes*
End

Style Summary
End

Style Summary*
End

Style Conclusion
End

Style Conclusion*
End

Style Acknowledgement
End

Style Acknowledgement*
End

Style Criterion
	CopyStyle             Theorem
  Category Definitions
	DependsOn	            Theorem
	LatexName             criterion
	LabelString           "Criterion \thetheorem."
	TheoremName                 criterion
	TheoremLaTeXName            criterionname
	TheoremStyle                thmplusPlain
	TheoremCounter              thm
	TheoremParentCounter        ""
	TheoremCrossRefName         Criterion
	TheoremCrossRefPluralName   Criteria
	TheoremZRefName             none
	LangPreamble
	  \providecommand{\criterionname}{_(Criterion)}
	EndLangPreamble
	BabelPreamble
	  \addto\captions$$lang{\renewcommand{\criterionname}{_(Criterion)}}

    \AddToHook{begindocument/end}{%
      \ifdefined\crefname
        \ifdefined\extras$$lang\addto\extras$$lang{\crefname{criterion}{_(criterion)}{_(criteria)}\Crefname{criterion}{_(Criterion)}{_(Criteria)}}\fi
      \fi
    }
  EndBabelPreamble
	RefPrefix cri
End


